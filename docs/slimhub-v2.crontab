# SLIMHUB_v2 database update (install with `crontab -e` after reviewing paths).
#
# The ingest job reads today's programdata/reports/*.jsonl incrementally and
# writes selected IN/OUT and final ADL records to local MySQL. The upload job
# copies committed local rows to remote MySQL by local table id. Put credentials
# in a protected wrapper or EnvironmentFile; never place them here.
#
# This mirrors the deployed SLIMHUB policy: local ingest every 3 minutes and
# remote upload every 10 minutes. A shared lock serializes coincident runs.
*/3 * * * * flock -w 120 /tmp/slimhub-v2-db-sync.lock sh -c 'cd /home/rtlab/SLIMHUB_v2 && /home/rtlab/SLIMHUB_v2/.venv/bin/slimhub-v2 --base-dir /home/rtlab/SLIMHUB_v2 db ingest >> /home/rtlab/SLIMHUB_v2/logs/db-ingest.log 2>&1'
*/10 * * * * flock -w 120 /tmp/slimhub-v2-db-sync.lock sh -c 'cd /home/rtlab/SLIMHUB_v2 && /home/rtlab/SLIMHUB_v2/.venv/bin/slimhub-v2 --base-dir /home/rtlab/SLIMHUB_v2 db upload >> /home/rtlab/SLIMHUB_v2/logs/db-upload.log 2>&1'
