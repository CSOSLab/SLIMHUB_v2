# Copy to /home/rtlab/.config/slimhub-v2/db.env and chmod 600.
SLIMHUB_LOCAL_DB_HOST=localhost
SLIMHUB_LOCAL_DB_PORT=3306
SLIMHUB_LOCAL_DB_USER=
SLIMHUB_LOCAL_DB_PASS=
SLIMHUB_LOCAL_DB_NAME=adl_event

SLIMHUB_REMOTE_DB_HOST=
SLIMHUB_REMOTE_DB_PORT=4404
SLIMHUB_REMOTE_DB_USER=
SLIMHUB_REMOTE_DB_PASS=
