# Copy to /home/rtlab/.config/slimhub-v2/db.env and chmod 600.
SLIMHUB_LOCAL_DB_HOST=localhost
SLIMHUB_LOCAL_DB_PORT=3306
SLIMHUB_LOCAL_DB_USER=
SLIMHUB_LOCAL_DB_PASS=
SLIMHUB_LOCAL_DB_NAME=adl_event

SLIMHUB_REMOTE_DB_HOST=
SLIMHUB_REMOTE_DB_PORT=4404
SLIMHUB_REMOTE_DB_USER=
SLIMHUB_REMOTE_DB_PASS=
SLIMHUB_REMOTE_DB_NAME=adl_raw

# Optional deployment identifier. Defaults to programdata/config.json address.
# SLIMHUB_HOUSE_MAC=

# Optional: from this date in_out comes from data/legacy_inout (v1 one-active-room
# IN/OUT built from rawdata Node ENTERs). Unset keeps rawdata for every date.
# SLIMHUB_LEGACY_INOUT_FROM=2026-10-20
# SLIMHUB_LEGACY_INOUT_LAG_SECONDS=60
